# All four are required for the signed-in cloud gallery.
# Leave them unset and the app runs 100% local (IndexedDB) with no network calls.
VITE_GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
VITE_AWS_REGION=us-east-1
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:00000000-0000-0000-0000-000000000000
VITE_S3_BUCKET=my-slate-bucket
